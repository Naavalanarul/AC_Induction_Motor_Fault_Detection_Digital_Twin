# Copy to .env for local development. Real secrets are injected via the
# environment at deploy time -- never commit a filled-in .env.
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true
DATABASE_URL=mysql+pymysql://dt:change-me@localhost:3306/digital_twin
# Local-dev convenience only; staging/production run `alembic upgrade head` explicitly.
AUTO_CREATE_SCHEMA=false
REDIS_URL=
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173
RUN_SIMULATION=true
SEED_DEMO_MOTOR=true
REALTIME_FACTOR=1.0
STREAM_HZ=10
PERSIST_INTERVAL_S=1.0
USE_ML=true
RETENTION_DAYS=30
LOGIN_RATE_PER_MIN=10
FAULT_RATE_PER_MIN=30
FEATURE_FLAGS=
